<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SchoolOnAppConnect"
        android:usesCleartextTraffic="false">

        <!-- REQUIRED. androidbrowserhelper's LauncherActivity.launchTwa() calls
             PackageManager.setComponentEnabledSetting() on this component on every
             launch to maintain the "Site Settings" shortcut. The library does NOT
             declare it in its own manifest (2.6.2 and 2.7.4 both ship without it),
             so if the app omits it the launch throws:

                 IllegalArgumentException: Component class
                 com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity
                 does not exist in <package>

             and the app crashes before the TWA ever opens. See the official
             twa-basic demo manifest for the reference declaration. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <meta-data
                android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                android:value="https://schoolonapp.in/" />
        </activity>

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SchoolOnAppConnect.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Start URL of the Trusted Web Activity -->
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launch_url" />

            <!-- Colours used by Chrome while the TWA is open -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/brand_primary_dark" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/brand_primary" />

            <!-- If Digital Asset Links verification fails (or Chrome is missing),
                 open in a Custom Tab instead of crashing. -->
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="customtabs" />

            <meta-data
                android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION"
                android:value="default" />

            <!-- Splash screen. Chrome draws this itself during the hand-off,
                 which is what prevents its toolbar from being visible while it
                 verifies the origin and warms up the TWA session. -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash_logo" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/splash_background" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="@string/file_provider_authority" />
        </activity>

        <!-- Hands the splash bitmap above to Chrome. Required for the splash
             screen to work at all; harmless otherwise. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@string/file_provider_authority"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>

</manifest>
